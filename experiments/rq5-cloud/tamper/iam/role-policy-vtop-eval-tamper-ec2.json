{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TamperLockBucketLevel",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::vtop-eval-lock-XXXXXXXXXXXX"
    },
    {
      "Sid": "TamperLockBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:GetObjectVersionAttributes",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectRetention",
        "s3:GetObjectRetention",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::vtop-eval-lock-XXXXXXXXXXXX/tamper/*"
    },
    {
      "Sid": "TamperMainBucketConfigRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": "arn:aws:s3:::vtop-eval-XXXXXXXXXXXX"
    }
  ]
}
