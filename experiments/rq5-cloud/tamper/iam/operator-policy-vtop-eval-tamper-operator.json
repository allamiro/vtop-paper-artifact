{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TamperLockBucketInspect",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::vtop-eval-lock-XXXXXXXXXXXX"
    },
    {
      "Sid": "TamperLockBucketReadAndCleanUp",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::vtop-eval-lock-XXXXXXXXXXXX/*"
    },
    {
      "Sid": "TamperMainBucketConfigRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": "arn:aws:s3:::vtop-eval-XXXXXXXXXXXX"
    }
  ]
}
